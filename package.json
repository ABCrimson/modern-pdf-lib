{
  "name": "modern-pdf-lib",
  "version": "0.40.9",
  "description": "A modern TypeScript PDF engine to create, parse, extract, fill, merge, and sign PDFs",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./create": {
      "import": {
        "types": "./dist/create.d.mts",
        "default": "./dist/create.mjs"
      },
      "require": {
        "types": "./dist/create.d.cts",
        "default": "./dist/create.cjs"
      }
    },
    "./parse": {
      "import": {
        "types": "./dist/parse.d.mts",
        "default": "./dist/parse.mjs"
      },
      "require": {
        "types": "./dist/parse.d.cts",
        "default": "./dist/parse.cjs"
      }
    },
    "./forms": {
      "import": {
        "types": "./dist/forms.d.mts",
        "default": "./dist/forms.mjs"
      },
      "require": {
        "types": "./dist/forms.d.cts",
        "default": "./dist/forms.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      }
    },
    "./wasm/*": "./dist/wasm/*"
  },
  "bin": {
    "modern-pdf": "./dist/cli/index.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/browser.mjs",
  "jsdelivr": "./dist/browser.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.mts",
    "dist/**/*.d.cts",
    "dist/modern-pdf-lib.iife.js",
    "dist/wasm/**",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=26.4"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown && node scripts/build/build-iife.ts && node scripts/build/smoke-dist.mjs",
    "smoke": "node scripts/build/smoke-dist.mjs",
    "build:iife": "node scripts/build/build-iife.ts",
    "build:wasm": "bash scripts/build/build-wasm.sh",
    "build:all": "pnpm run build:wasm && pnpm run build && pnpm run copy:wasm",
    "copy:wasm": "node scripts/build/copy-wasm.mjs",
    "check:pack": "node scripts/build/check-pack.mjs",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:oracle": "vitest run --project oracle",
    "test:adversarial": "vitest run --project adversarial",
    "test:e2e": "playwright test",
    "test:bench": "vitest bench",
    "bench": "tsx tests/benchmarks/run.ts",
    "lint": "oxlint --max-warnings=1154 src tests",
    "lint:fix": "oxlint --fix src tests",
    "format": "oxfmt src tests scripts",
    "format:check": "oxfmt --check src tests scripts",
    "typecheck": "tsc --noEmit && tsc -p src/cli/tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p tests/tsconfig.json && tsc -p tests/tsconfig.security.json",
    "typecheck:security-tests": "tsc -p tests/tsconfig.security.json",
    "fixtures:legacy": "node scripts/fixtures/legacy-0.40.3/generate.ts",
    "fixtures:legacy:check": "node scripts/fixtures/legacy-0.40.3/generate.ts --check",
    "fixtures:encrypted": "node scripts/fixtures/encrypted-fixtures.ts",
    "fixtures:encrypted:check": "node scripts/fixtures/encrypted-fixtures.ts --check",
    "fixtures:streams:check": "tsx scripts/fixtures/stream-digests.ts --check",
    "check:known-defects": "node scripts/dev/known-defects.ts --check",
    "check:test-projects": "node scripts/dev/test-projects.ts --check",
    "corpus:check": "node scripts/dev/corpus.ts --check",
    "api:check": "vitest run tests/oracle/packaging/exports.test.ts",
    "api:update": "vitest run tests/oracle/packaging/exports.test.ts -u",
    "gate:surface": "node scripts/dev/surface-gate.ts",
    "gate:cap": "node scripts/dev/capability-gate.ts",
    "gate:size": "node scripts/dev/size-gate.ts",
    "gate:layout": "node scripts/dev/surface-gate.ts --layout",
    "check:docs": "node scripts/dev/metrics.ts --check",
    "conformance:generate": "tsx scripts/conformance/generate.ts",
    "conformance:verapdf": "node scripts/conformance/verapdf-validate.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:api": "node tools/docs/node_modules/typedoc/bin/typedoc --options tools/docs/typedoc.json && node scripts/build/sanitize-api-docs.ts",
    "validate-pdf": "node scripts/dev/validate-pdf.ts",
    "generate:wasm-inline": "node scripts/build/generate-inline-wasm.ts",
    "clean": "node -e \"for (const d of ['dist','coverage']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.66.0-alpha-1794252756000",
    "@types/node": "26.6.11",
    "@vitest/coverage-v8": "5.1.2",
    "esbuild": "0.28.2",
    "oxc-parser": "0.160.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "publint": "0.3.25",
    "tinybench": "6.2.5",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "7.1.0-dev.20261116.1",
    "vite": "8.4.0-beta.2",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "5.1.2",
    "vue": "3.6.0-rc.16",
    "wasm-pack": "0.15.1"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "pdf-parser",
    "pdf-extraction",
    "text-extraction",
    "pdf-forms",
    "pdf-signature",
    "typescript",
    "esm",
    "cloudflare-workers",
    "streaming"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABCrimson/modern-pdf-lib.git"
  },
  "homepage": "https://abcrimson.github.io/modern-pdf-lib/",
  "bugs": {
    "url": "https://github.com/ABCrimson/modern-pdf-lib/issues"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "28.0.0-nightly20261111e8c1160d20",
      "onFail": "download"
    }
  }
}
