{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "isolatedDeclarations": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["tests/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tests/adversarial/formScript.test.ts",
    "tests/oracle/redaction-leak.test.ts",
    "tests/unit/signature/trust-anchors.test.ts",
    "tests/unit/core/encryption-guard.test.ts",
    "tests/unit/core/merge-dedupe.test.ts",
    "tests/oracle/legacy-0.40.3.test.ts",
    "tests/unit/core/securityErrors.test.ts",
    "tests/unit/helpers/known-defect.test.ts",
    "tests/helpers/**/*.ts"
  ]
}
